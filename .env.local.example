# ─────────────────────────────────────────────────────────────────────────────
# SplitSOL — devnet only. Mainnet variables are intentionally absent so that a
# production network can never be selected by accident. See SETUP.md step 9.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FEE_PERCENTAGE=0
FEE_COLLECTOR_WALLET=

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Solana — DEVNET ONLY ─────────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# ── Anchor program ──────────────────────────────────────────────────────────
# Obtained from `anchor deploy`:  anchor keys list
NEXT_PUBLIC_PROGRAM_ID=
# Base58 IDL version string (optional, lets the client prove the program is live)
NEXT_PUBLIC_PROGRAM_VERSION=0.1.0

# ── Test SPL token (tUSDC) ───────────────────────────────────────────────────
# Created by:  spl-token create-token --decimals 6   (or scripts/setup-devnet.sh)
NEXT_PUBLIC_TEST_TOKEN_MINT=
NEXT_PUBLIC_TEST_TOKEN_SYMBOL=tUSDC
NEXT_PUBLIC_TEST_TOKEN_DECIMALS=6

# ── Devnet mint authority (server side only) ─────────────────────────────────
# node -e "console.log(JSON.stringify(Array.from(require('fs').readFileSync('./mint-authority.json'))))"
# NEVER commit the keypair file itself.
DEVNET_MINT_AUTHORITY_SECRET=

# ── Devnet faucet (optional, server side) ────────────────────────────────────
# Plain HTTP endpoint from https://faucet.solana.com — helps when the public
# devnet airdrop RPC is rate limited.
DEVNET_FAUCET_URL=
